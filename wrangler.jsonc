{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visualon",
  "compatibility_date": "2026-10-01",
  "pages_build_output_dir": "./dist",
  // This file is the source of truth for build variables (the Pages dashboard values are ignored while it exists).
  // Top-level vars = production (main). env.preview = dev and every other branch.
  // PUBLIC_GA_ID: the GA4 measurement id (G-...). Production only, so previews send nothing; empty = analytics off.
  "vars": { "PUBLIC_DODO_MODE": "live", "PUBLIC_GA_ID": "" },
  "env": {
    "preview": { "vars": { "PUBLIC_DODO_MODE": "test" } }
  }
}
