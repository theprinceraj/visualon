---
import Base from "./Base.astro";
interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={`${title} · VisualOn`} description={description}>
  <article class="legal on-paper section wrap">
    <div class="label caps"><span class="num">§</span><span class="txt">— last updated {updated}</span></div>
    <h1 class="display">{title}</h1>
    <div class="body read"><slot /></div>
  </article>
</Base>

<style>
  .legal {
    padding-block: 150px 120px;
  }
  h1 {
    margin: 28px 0 56px;
    font-size: clamp(48px, 7vw, 104px);
  }
  .body {
    max-width: 44em;
    font-size: 16px;
  }
  .body :global(h2) {
    font-family: var(--display);
    font-weight: 400;
    font-size: 28px;
    margin: 48px 0 12px;
    letter-spacing: -0.01em;
  }
  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  .body :global(li) {
    margin-bottom: 6px;
  }
</style>
