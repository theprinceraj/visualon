---
import { vertical, media, projects } from "../data/site";
// Vertical cuts first, then square/4:5 to fill the shelf.
const extra = projects.flatMap((p) => p.media.filter((m) => m.ratio === "1x1" || m.ratio === "4x5").map((m) => ({ project: p, ratio: m.ratio })));
const shelf = [...vertical, ...extra.filter((e) => !vertical.some((v) => v.project.slug === e.project.slug))];
---

<section class="reels on-ink section" aria-labelledby="reels-title">
  <div class="wrap">
    <div class="head">
      <div class="label caps" data-reveal><span class="num">02</span><span class="txt">— made for the feed</span></div>
      <a href="/work" class="link-arrow caps">every cut, up close <span class="arr">→</span></a>
    </div>
    <h2 id="reels-title" class="display title" data-reveal>Thumb-stopping, <em>too</em>.</h2>
    <p class="read muted lede" data-reveal>vertical and square cuts for reels, shorts and tiktok, reframed for the feed instead of cropped.</p>
  </div>
  <div class="shelf wrap" data-reveal>
    {
      shelf.map(({ project, ratio }) => (
        <a href={`/work/${project.slug}`} class="card" data-hoverplay>
          <div class:list={["frame", `r${ratio}`]}>
            <video
              muted
              loop
              playsinline
              preload="none"
              poster={media(project.slug, ratio, "preview.jpg")}
              src={media(project.slug, ratio, "preview.mp4")}
            />
          </div>
          <span class="cap">
            <span>{project.title}</span>
            <span class="caps r">{ratio.replace("x", ":")} ↗</span>
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .reels {
    padding-block: 120px 140px;
    border-top: 1px solid var(--line-paper);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .title {
    margin: 28px 0 22px;
    font-size: clamp(40px, 4.4vw, 68px);
  }
  .lede {
    max-width: 26em;
    margin: 0 0 56px;
  }
  .shelf {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(200px, 1fr);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    align-items: end;
  }
  .shelf::-webkit-scrollbar {
    display: none;
  }
  .card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .frame {
    overflow: hidden;
    background: var(--ink-soft);
    aspect-ratio: 9 / 16;
  }
  .frame.r4x5 {
    aspect-ratio: 4 / 5;
  }
  .frame.r1x1 {
    aspect-ratio: 1;
  }
  .frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-expo);
  }
  .card:hover video {
    transform: scale(1.035);
  }
  .cap {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
  }
  .r {
    font-size: 11px;
    color: #9a9da4;
  }
  @media (max-width: 860px) {
    .shelf {
      grid-auto-columns: 64vw;
    }
    .head .link-arrow {
      display: none;
    }
  }
</style>
