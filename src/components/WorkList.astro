---
import { featured, media, projects } from "../data/site";
const first = featured[0];
---

<section class="work on-ink section" id="work">
  <div class="grid wrap">
    <div class="left">
      <div class="label caps" data-reveal><span class="num">01</span><span class="txt">— selected work</span></div>
      <h2 class="display title" data-reveal>
        <span class="line-mask"><span>Work that</span></span>
        <span class="line-mask"><span><em>plays.</em></span></span>
      </h2>
      <a class="preview" href={`/work/${first.slug}`} data-preview data-reveal aria-label={`Watch ${first.title}`}>
        {
          featured.map((p, i) => (
            <video
              class:list={["pv", { on: i === 0 }]}
              data-slug={p.slug}
              muted
              loop
              playsinline
              preload={i === 0 ? "auto" : "none"}
              poster={media(p.slug, "16x9", "preview.jpg")}
              src={media(p.slug, "16x9", "preview.mp4")}
            />
          ))
        }
        <span class="pv-tag caps"><span data-pv-title>{first.title}</span> — <span class="it" data-pv-line>{first.logline}</span></span>
      </a>
    </div>

    <div class="right">
      <ol class="rows">
        {
          featured.map((p, i) => (
            <li data-reveal>
              <a href={`/work/${p.slug}`} class="row" data-row={p.slug} data-title={p.title} data-line={p.logline}>
                <span class="n caps">{String(i + 1).padStart(2, "0")}/</span>
                <span class="t display">{p.title}</span>
                <span class="meta caps">
                  {p.tags.join(" / ")} · {p.year}
                </span>
                <img class="m-thumb" src={media(p.slug, "16x9", "poster.jpg")} alt={`${p.title} ${p.tags[0]} video`} loading="lazy" />
              </a>
            </li>
          ))
        }
      </ol>
      <div class="foot caps muted">
        <span>launch films · reels · ads · tutorials</span>
        <a href="/work" class="link-arrow on">( all {projects.length} projects <span class="arr">→</span> )</a>
      </div>
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: 140px 160px;
    border-top: 1px solid var(--line-paper);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.1fr);
    gap: 64px;
  }
  .left {
    position: sticky;
    top: 110px;
    align-self: start;
  }
  .title {
    margin: 28px 0 44px;
    font-size: clamp(46px, 6.4vw, 104px);
  }
  .preview {
    position: relative;
    display: block;
    border: 1px solid var(--line-paper);
    padding: 12px;
    aspect-ratio: 16 / 9;
    box-sizing: content-box;
    width: calc(100% - 26px);
  }
  .pv {
    position: absolute;
    inset: 12px;
    width: calc(100% - 24px);
    height: calc(100% - 24px);
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.45s;
  }
  .pv.on {
    opacity: 1;
  }
  .pv-tag {
    position: absolute;
    left: 12px;
    top: calc(100% + 14px);
    font-size: 11px;
    color: #9a9da4;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-paper);
  }
  .row {
    display: grid;
    grid-template-columns: 66px 1fr auto;
    align-items: baseline;
    padding: 30px 0 32px;
    border-bottom: 1px solid var(--line-paper);
    transition: color 0.3s;
  }
  .n {
    font-size: 11px;
    color: #9a9da4;
  }
  .t {
    font-size: clamp(34px, 4.1vw, 64px);
    line-height: 1;
    transition: transform 0.5s var(--ease-expo);
  }
  .meta {
    font-size: 11px;
    color: #9a9da4;
    text-align: right;
  }
  .rows:hover .row:not(:hover) {
    color: #55585e;
  }
  .row:hover .t {
    transform: translateX(14px);
  }
  .m-thumb {
    display: none;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    font-size: 11px;
  }
  .foot a:hover {
    color: var(--paper);
  }
  @media (max-width: 960px) {
    .work {
      padding-block: 100px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .left {
      position: static;
    }
    .preview {
      display: none;
    }
    .title {
      margin-bottom: 8px;
      font-size: clamp(40px, 11vw, 64px);
    }
    .row {
      grid-template-columns: 44px 1fr;
      row-gap: 10px;
    }
    .meta {
      grid-column: 2;
      text-align: left;
    }
    .m-thumb {
      display: block;
      grid-column: 1 / -1;
      margin-top: 14px;
      aspect-ratio: 16 / 9;
      width: 100%;
      object-fit: cover;
      border: 1px solid var(--line-paper);
    }
    .foot {
      flex-direction: column;
    }
  }
</style>
