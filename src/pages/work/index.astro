---
import Base from "../../layouts/Base.astro";
import WorkCard from "../../components/WorkCard.astro";
import { projects } from "../../data/site";
import { breadcrumbs } from "../../data/seo";
---

<Base
  title="Work: AI Product Video Portfolio · VisualOn"
  description={`${projects.length} AI product videos, launch films, reels and ads for SaaS, apps and e-commerce brands, each with the brief and the idea behind it.`}
  schema={[breadcrumbs(Astro.site!, [["Work", "/work"]])]}
>
  <section class="all on-ink section">
    <div class="wrap">
      <div class="label caps"><span class="num">01</span><span class="txt">— the whole shelf</span></div>
      <h1 class="display">All the <em>work</em>.</h1>
      <p class="read muted lede">{projects.length} products, each one shown as it really is: its own ui, its own copy, its own colours.</p>
    </div>
    <div class="grid wrap">
      {projects.map((p, i) => <WorkCard p={p} n={i + 1} />)}
    </div>
  </section>
</Base>

<style>
  .all {
    padding-block: 140px 140px;
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(56px, 8vw, 128px);
  }
  .lede {
    max-width: 30em;
    margin: 24px 0 72px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px 32px;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
