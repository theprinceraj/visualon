---
import Base from "../../layouts/Base.astro";
import WorkCard from "../../components/WorkCard.astro";
import CaseFilm from "../../components/CaseFilm.astro";
import { projects, media, type Project } from "../../data/site";
import { breadcrumbs, video } from "../../data/seo";

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, n: i + 1, next: projects[(i + 1) % projects.length] } }));
}
const { p, n, next } = Astro.props as { p: Project; n: number; next: Project };
const main = p.media[0];
const story = p.story;
const kind = /film|reel|ad$|video/.test(p.tags[0]) ? p.tags[0] : `${p.tags[0]} video`;
const schema = [
  video(Astro.site!, p),
  ...(p.films ?? []).map((f) => video(Astro.site!, p, f)),
  breadcrumbs(Astro.site!, [["Work", "/work"], [p.title, `/work/${p.slug}`]]),
];
// Related: most shared tags first, then the portfolio order. The next project already has its own link.
const related = projects
  .filter((x) => x !== p && x !== next)
  .map((x, i) => ({ x, i, score: x.tags.filter((t) => p.tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score || a.i - b.i)
  .slice(0, 2)
  .map(({ x }) => x);
---

<Base
  title={`${p.title}: ${kind} by VisualOn`}
  description={`${p.logline} ${p.brief}`}
  image={media(p.slug, main.ratio, "poster.jpg")}
  schema={schema}
>
  <article class="case on-ink section">
    <header class="head wrap">
      <a href="/#work" class="link-arrow caps back"><span class="arr">←</span> all work</a>
      <div class="label caps"><span class="num">{String(n).padStart(2, "0")}</span><span class="txt">— {p.tags.join(" / ")} · {p.year}{p.concept ? " · concept" : ""}</span></div>
      <h1 class="display">{p.title}</h1>
      <p class="display it blue logline">{p.logline}</p>
    </header>

    <CaseFilm id="player" base={p.slug} items={p.media} brief={p.brief} idea={story?.idea ?? p.approach} story={story} />

    {
      p.films?.map((f) => (
        <section class="further" aria-labelledby={`${f.id}-h`}>
          <header class="wrap">
            <span class="caps muted">another film for {p.title}</span>
            <h2 class="display fh" id={`${f.id}-h`}>{f.title}</h2>
            <p class="display it blue logline">{f.logline}</p>
          </header>
          <CaseFilm id={f.id} base={`${p.slug}/${f.id}`} items={f.media} brief={f.brief} idea={f.story?.idea ?? f.approach} story={f.story} level={3} />
        </section>
      ))
    }

    {
      (p.turnaround || !p.concept) && (
        <section class="result wrap">
          <span class="caps muted">the result</span>
          {p.turnaround && (
            <p class="display stat">
              {p.turnaround} <em class="blue">from request to final cut.</em>
            </p>
          )}
          {!p.concept && <p class="lead">The client was stunned by the result, and more so that it was made entirely by AI.</p>}
          {p.concept && <p class="lead">A concept piece: no client, same pipeline, same turnaround as client work.</p>}
        </section>
      )
    }

    <section class="more wrap" aria-labelledby="more-h">
      <span class="caps muted" id="more-h">more like this</span>
      <div class="grid">{related.map((r) => <WorkCard p={r} n={projects.indexOf(r) + 1} />)}</div>
    </section>

    <a href={`/work/${next.slug}`} class="next wrap">
      <span class="caps muted">next</span>
      <span class="display">{next.title} <span class="arr">→</span></span>
    </a>
  </article>
</Base>

<style>
  .case {
    padding-top: 130px;
  }
  .back {
    color: #9a9da4;
    margin-bottom: 48px;
  }
  .back:hover {
    color: var(--paper);
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(56px, 9vw, 150px);
  }
  .logline {
    font-size: clamp(22px, 2.4vw, 36px);
    margin: 18px 0 0;
    color: var(--accent-soft);
  }
  .lead {
    font-family: var(--body);
    font-size: clamp(19px, 1.7vw, 24px);
    line-height: 1.45;
    margin: 16px 0 0;
    max-width: 34em;
  }
  .result,
  .more {
    padding-block: 72px;
    border-top: 1px solid var(--line-paper);
  }
  .further {
    padding-top: 96px;
  }
  .fh {
    font-size: clamp(44px, 6vw, 96px);
    margin: 20px 0 0;
  }
  .stat {
    font-size: clamp(40px, 6vw, 96px);
    margin: 20px 0 0;
  }
  .more .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 32px;
    margin-top: 28px;
  }
  .next {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 64px 96px;
    border-top: 1px solid var(--line-paper);
  }
  .next .display {
    font-size: clamp(40px, 6vw, 96px);
  }
  .next .arr {
    display: inline-block;
    transition: transform 0.5s var(--ease-expo);
  }
  .next:hover .arr {
    transform: translateX(16px);
  }
  @media (max-width: 860px) {
    .more .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

