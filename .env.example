PUBLIC_MEDIA_BASE=https://media.visualon.top
# "test" uses test.checkout.dodopayments.com, "live" uses checkout.dodopayments.com
PUBLIC_DODO_MODE=test
# Canonical site URL (used for redirect_url after payment)
SITE_URL=https://visualon.theprinceraj.in
