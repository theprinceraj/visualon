# Where videos are served from. Leave unset in dev (uses public/media). In production, the R2 public URL.
PUBLIC_MEDIA_BASE=https://pub-8f13f60a2584475488fcd0bb210a757d.r2.dev
# "test" uses test.checkout.dodopayments.com, "live" uses checkout.dodopayments.com
PUBLIC_DODO_MODE=test
# Canonical site URL (used for redirect_url after payment)
SITE_URL=https://visualon.theprinceraj.in
# GA4 measurement id (G-XXXXXXXXXX). Analytics is off when empty, and only runs on the site's own domain;
# add ?ga_debug=1 to a page URL to send events from localhost or a preview to GA's DebugView.
PUBLIC_GA_ID=
